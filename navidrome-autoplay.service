[Unit]
Description=Navidrome Autoplay Recommendation Service
After=network.target navidrome.service
Wants=navidrome.service

[Service]
Type=simple
User=navidrome
Group=navidrome
WorkingDirectory=/root/navidrome-autoplay
ExecStart=/root/navidrome-autoplay/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 30 --bind 127.0.0.1:8001 --bind 127.0.0.1:8000 "server:create_app()"
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=AUTOPLAY_PORT=8001
Environment=AUTOPLAY_HOST=127.0.0.1

# Sandboxing & Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/root/navidrome-autoplay /tmp

[Install]
WantedBy=multi-user.target
