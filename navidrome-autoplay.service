[Unit]
Description=Navidrome Autoplay Recommendation Service
After=network.target navidrome.service
Wants=navidrome.service

[Service]
Type=simple
User=navidrome
Group=navidrome
WorkingDirectory=/opt/navidrome-autoplay
ExecStart=/opt/navidrome-autoplay/.venv/bin/python /opt/navidrome-autoplay/server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=AUTOPLAY_PORT=8001
Environment=AUTOPLAY_HOST=127.0.0.1

# Sandboxing & Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/navidrome-autoplay /tmp

[Install]
WantedBy=multi-user.target
